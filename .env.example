# OpsFlow 360 – Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# Security & Authentication
JWT_SECRET="opsflow-360-jwt-super-secret-key-change-in-production"
JWT_REFRESH_SECRET="opsflow-360-jwt-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Google Sheets Database Integration
# OpsFlow 360 operates with built-in resilient Sheets data storage and seed records.
